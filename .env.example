# Database (Neon Postgres — https://neon.tech)
DATABASE_URL=

# Auth core
BETTER_AUTH_SECRET=
# The URL this app is served from (local: http://localhost:3000)
BETTER_AUTH_URL=

# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Nimfi <noreply@yourdomain.com>"
# Optional overrides
EMAIL_BRAND_NAME=
EMAIL_REPLY_TO=
EMAIL_SUPPORT=

# Billplz billing (https://www.billplz.com — sandbox: billplz-sandbox.com)
BILLPLZ_SECRET_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# sandbox | production
BILLPLZ_MODE=sandbox

# Protects /api/cron/billing-reminders (Vercel Cron sends this as a bearer token)
CRON_SECRET=
